{
  "name": "defi-news-bot",
  "version": "1.0.0",
  "description": "DeFi News Aggregator Bot - Monitors DeFiLlama, Twitter, and CoinGecko for DeFi signals",
  "main": "dist/cron.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cron.ts",
    "start": "node dist/cron.js",
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint src/",
    "migrate": "tsx scripts/migrate.ts",
    "deploy": "npm run build && serverless deploy",
    "deploy:prod": "npm run build && serverless deploy --stage prod",
    "remove": "serverless remove"
  },
  "keywords": [
    "defi",
    "telegram",
    "bot",
    "crypto",
    "tvl",
    "alerts"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "axios-retry": "^4.4.0",
    "better-sqlite3": "^11.5.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.0",
    "lru-cache": "^11.0.0",
    "p-queue": "^8.0.1",
    "twitter-api-v2": "^1.17.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
