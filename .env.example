# Telegram Configuration
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID"
TELEGRAM_ADMIN_ID="YOUR_ADMIN_ID"
MESSAGE_THREAD_ID=your_thread_id_here

# RapidAPI (Required for Twitter collector)
# Get your key from: https://rapidapi.com/alexanderxbx/api/twitter-api45
RAPIDAPI_KEY=your_rapidapi_key_here

# CoinGecko API (Optional - for higher rate limits)
# Get your key from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Phase 2 API Keys

# CryptoPanic API (Required for news aggregation)
# Get your key from: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key

# Token Unlocks API (Optional)
# Get your key from: https://token.unlocks.app/
TOKEN_UNLOCKS_API_KEY=

# Node Environment
NODE_ENV=development
